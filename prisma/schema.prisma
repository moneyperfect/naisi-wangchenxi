generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Anniversary {
  id          Int      @id @default(autoincrement())
  title       String
  date        String
  description String?
  isYearly    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Photo {
  id        Int      @id @default(autoincrement())
  url       String
  caption   String?
  takenAt   String?
  createdAt DateTime @default(now())
}

model TimelineEvent {
  id          Int      @id @default(autoincrement())
  title       String
  date        String
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model Letter {
  id        Int      @id @default(autoincrement())
  author    String
  title     String?
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model QuizQuestion {
  id        Int      @id @default(autoincrement())
  question  String
  optionA   String
  optionB   String
  optionC   String
  optionD   String
  correct   String
  createdAt DateTime @default(now())
}

model DiaryEntry {
  id        Int      @id @default(autoincrement())
  author    String
  content   String
  mood      String?
  date      String
  createdAt DateTime @default(now())
}
